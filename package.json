{
  "name": "tasmania",
  "productName": "Tasmania",
  "version": "0.0.5",
  "description": "Run local LLMs easily — batteries included",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "package": "npm run build:mcp && electron-forge package",
    "make": "npm run build:mcp && electron-forge make",
    "lint": "tsc --noEmit",
    "verify": "bash scripts/verify-package.sh",
    "dmg": "electron-forge package && bash scripts/verify-package.sh && bash scripts/create-dmg.sh",
    "postinstall": "bash scripts/download-llama.sh && bash scripts/download-sd.sh"
  },
  "keywords": [
    "llm",
    "local",
    "llama.cpp",
    "electron"
  ],
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.3",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-store": "^11.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "34.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
