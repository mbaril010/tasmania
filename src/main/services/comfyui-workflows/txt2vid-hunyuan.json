{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "hunyuan_video_bf16.safetensors",
      "weight_dtype": "bf16"
    }
  },
  "3": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "clip_l.safetensors",
      "clip_name2": "llava_llama3_fp16.safetensors",
      "type": "hunyuan_video"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["3", 0]
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": ["3", 0]
    }
  },
  "6": {
    "class_type": "EmptyHunyuanLatentVideo",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "length": "{{frame_count}}",
      "batch_size": 1
    }
  },
  "10": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "hunyuan_video_vae_bf16.safetensors"
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg_scale}}",
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["7", 0],
      "vae": ["10", 0]
    }
  },
  "9": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "frame_rate": "{{fps}}",
      "loop_count": 0,
      "filename_prefix": "hunyuan_txt2vid",
      "format": "video/h264-mp4",
      "images": ["8", 0]
    }
  }
}
