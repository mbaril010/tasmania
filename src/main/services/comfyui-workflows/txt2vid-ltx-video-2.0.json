{
  "1": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "ltx-2.3-22b-dev-BF16.gguf"
    }
  },
  "2": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.3-22b-distilled_video_vae.safetensors"
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "t5xxl_fp16.safetensors",
      "type": "ltxv"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["3", 0]
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": ["3", 0]
    }
  },
  "6": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "length": "{{frame_count}}",
      "batch_size": 1
    }
  },
  "7": {
    "class_type": "LTXVScheduler",
    "inputs": {
      "steps": "{{steps}}",
      "max_shift": 2.05,
      "base_shift": 0.95,
      "stretch": true,
      "terminal": 0.1,
      "latent": ["6", 0]
    }
  },
  "8": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "9": {
    "class_type": "SamplerCustom",
    "inputs": {
      "add_noise": true,
      "noise_seed": "{{seed}}",
      "cfg": "{{cfg_scale}}",
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "sampler": ["8", 0],
      "sigmas": ["7", 0],
      "latent_image": ["6", 0]
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["9", 0],
      "vae": ["2", 0]
    }
  },
  "11": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "frame_rate": "{{fps}}",
      "loop_count": 0,
      "filename_prefix": "ltxv_txt2vid",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true,
      "images": ["10", 0]
    }
  }
}
