{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.1_i2v_720p_bf16.safetensors",
      "weight_dtype": "bf16"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp16.safetensors",
      "type": "wan"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{init_image_name}}"
    }
  },
  "11": {
    "class_type": "ImageResize",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "method": "lanczos",
      "image": ["10", 0]
    }
  },
  "12": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    }
  },
  "13": {
    "class_type": "CLIPVisionEncode",
    "inputs": {
      "crop": "center",
      "clip_vision": ["12", 0],
      "image": ["11", 0]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["2", 0]
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": ["2", 0]
    }
  },
  "14": {
    "class_type": "unCLIPConditioning",
    "inputs": {
      "strength": 1.0,
      "noise_augmentation": 0.0,
      "conditioning": ["4", 0],
      "clip_vision_output": ["13", 0]
    }
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": "{{frame_count}}"
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg_scale}}",
      "sampler_name": "uni_pc_bh2",
      "scheduler": "normal",
      "denoise": "{{denoising_strength}}",
      "model": ["1", 0],
      "positive": ["14", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["7", 0],
      "vae": ["3", 0]
    }
  },
  "9": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "frame_rate": "{{fps}}",
      "loop_count": 0,
      "filename_prefix": "wan_img2vid",
      "format": "video/h264-mp4",
      "images": ["8", 0]
    }
  }
}
